{
  "name": "@qbv/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres read model, commands, auth tables: Kysely types, migrations, repositories",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@qbv/config": "*",
    "argon2": "0.45.1",
    "kysely": "0.28.18",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
