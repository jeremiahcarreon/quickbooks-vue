{
  "name": "@qbv/reports",
  "version": "0.1.0",
  "private": true,
  "description": "Report definitions: SQL operational reports over the read model and QuickBooks-sourced reports through the relay queue",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@qbv/db": "*",
    "@qbv/qbxml": "*",
    "@qbv/queue": "*",
    "kysely": "0.28.18"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "bullmq": "5.81.5",
    "fastify": "5.12.7"
  }
}
