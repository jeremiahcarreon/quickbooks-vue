{
  "name": "@qbv/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Single consumer of the relay queue: sends XSD-validated qbXML to QuickBooks through the relay and writes results through to the read model",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@qbv/config": "*",
    "@qbv/db": "*",
    "@qbv/qbxml": "*",
    "@qbv/queue": "*",
    "@qbv/relay-client": "*",
    "bullmq": "5.81.5",
    "fast-xml-parser": "5.2.5",
    "ioredis": "5.11.1"
  }
}
