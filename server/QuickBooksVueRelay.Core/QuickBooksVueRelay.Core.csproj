<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral parts of the relay: configuration, authentication,
    XSD validation, HTTP routing and health reporting. Kept free of COM and
    Windows APIs so it builds and is unit-tested on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuickBooksVueRelay</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickBooksVueRelay.Tests" />
  </ItemGroup>

</Project>
